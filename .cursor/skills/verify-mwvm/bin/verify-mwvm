#!/usr/bin/env bash
# Drive MWVM's cargo examples and the mwvm CLI. See ../SKILL.md.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/../../../.." && pwd)"
STATE=/tmp/verify-mwvm
EVIDENCE_ROOT="$ROOT/.cursor/skills/verify-mwvm/evidence"
LOCK="$STATE/lock"
CURRENT="$STATE/current"
MIN_RUSTC="1.85.0"

die() {
  printf 'verify-mwvm: %s\n' "$*" >&2
  exit 1
}

tmux_bin() {
  if [[ -f /exec-daemon/tmux.portal.conf ]]; then
    tmux -f /exec-daemon/tmux.portal.conf "$@"
  else
    tmux "$@"
  fi
}

rustc_version() {
  rustc --version | awk '{print $2}'
}

version_ge() {
  # $1 >= $2 (version sort)
  printf '%s\n%s\n' "$2" "$1" | sort -C -V
}

run_id() {
  if [[ -n "${VERIFY_RUN_ID:-}" ]]; then
    printf '%s\n' "$VERIFY_RUN_ID"
    return
  fi
  [[ -f "$CURRENT" ]] || die "no current run; launch first"
  cat "$CURRENT"
}

run_dir() {
  printf '%s/runs/%s\n' "$STATE" "$(run_id)"
}

evidence_dir() {
  printf '%s/%s\n' "$EVIDENCE_ROOT" "$(run_id)"
}

require_tools() {
  local missing=()
  local tool
  for tool in cargo rustc git tmux curl python3 sha256sum; do
    command -v "$tool" >/dev/null 2>&1 || missing+=("$tool")
  done
  if ((${#missing[@]})); then
    die "missing tools: ${missing[*]}"
  fi
  local have
  have="$(rustc_version)"
  version_ge "$have" "$MIN_RUSTC" || die "rustc $have is older than $MIN_RUSTC (blake3 1.8 needs edition 2024)"
}

sibling_manifest() {
  printf '%s\n' "$ROOT/../morpheum-primitives/Cargo.toml"
}

require_sibling() {
  local manifest
  manifest="$(sibling_manifest)"
  [[ -f "$manifest" ]] || die "missing sibling manifest $manifest"
}

git_head() {
  git -C "$ROOT" rev-parse HEAD
}

record_bins() {
  local dest="$1"
  (
    cd "$ROOT"
    sha256sum \
      target/debug/basic-agent \
      target/debug/swarm-example \
      target/debug/mwvm
  ) >"$dest"
}

check_bins() {
  local recorded="$1"
  local now
  now="$(mktemp)"
  record_bins "$now"
  if ! cmp -s "$recorded" "$now"; then
    echo "binary hash mismatch" >&2
    diff -u "$recorded" "$now" >&2 || true
    rm -f "$now"
    return 1
  fi
  rm -f "$now"
}

cmd_launch() {
  require_tools
  require_sibling
  mkdir -p "$STATE/runs" "$EVIDENCE_ROOT"
  if ! mkdir "$LOCK" 2>/dev/null; then
    die "another run holds $LOCK ($(cat "$LOCK/run_id" 2>/dev/null || echo unknown))"
  fi
  local id ev dir
  id="$(date -u +%Y%m%dT%H%M%SZ)-$$"
  printf '%s\n' "$id" >"$LOCK/run_id"
  printf '%s\n' "$id" >"$CURRENT"
  dir="$STATE/runs/$id"
  ev="$EVIDENCE_ROOT/$id"
  mkdir -p "$dir" "$ev"
  {
    echo "run_id=$id"
    echo "head=$(git_head)"
    echo "rustc=$(rustc --version)"
    echo "sibling=$(sibling_manifest)"
    sha256sum "$(sibling_manifest)" "$ROOT/../morpheum-primitives/src/lib.rs" || true
  } >"$dir/launch-meta.txt"
  cp "$dir/launch-meta.txt" "$ev/launch-meta.txt"
  echo "launch: cargo build -p basic-agent -p swarm-example -p mwvm-cli" | tee "$ev/launch.log"
  if ! cargo build -p basic-agent -p swarm-example -p mwvm-cli >>"$ev/launch.log" 2>&1; then
    echo "launch failed; evidence=$ev" | tee -a "$ev/launch.log" >&2
    exit 1
  fi
  record_bins "$dir/binaries.sha"
  cp "$dir/binaries.sha" "$ev/binaries.sha"
  echo "ready run_id=$id native=ready" | tee -a "$ev/launch.log"
}

cmd_doctor() {
  require_tools
  require_sibling
  local id dir ev head
  id="$(run_id)"
  dir="$(run_dir)"
  ev="$(evidence_dir)"
  [[ -d "$dir" ]] || die "run dir missing: $dir"
  [[ -f "$dir/launch-meta.txt" ]] || die "launch did not finish meta for $id"
  head="$(git_head)"
  local recorded_head
  recorded_head="$(awk -F= '$1=="head"{print $2}' "$dir/launch-meta.txt")"
  [[ "$head" == "$recorded_head" ]] || die "git head changed since launch ($recorded_head -> $head)"
  check_bins "$dir/binaries.sha" || die "binary hash mismatch since launch"
  local rustc_v
  rustc_v="$(rustc_version)"
  printf 'doctor ok run_id=%s head=%s rustc=%s sibling=%s\n' \
    "$id" "$head" "$rustc_v" "$(sibling_manifest)"
  # doctor is read-only; the caller may redirect this stdout into evidence
  :
}

write_runner() {
  local script="$1"
  local body="$2"
  {
    echo '#!/bin/bash'
    echo 'set -u'
    printf 'export PATH=%q\n' "$PATH"
    printf 'cd %q\n' "$ROOT"
    printf '%s\n' "$body"
  } >"$script"
  chmod +x "$script"
}

wait_session() {
  local session="$1"
  local i
  for i in $(seq 1 180); do
    if ! tmux_bin has-session -t "$session" 2>/dev/null; then
      return 0
    fi
    sleep 1
  done
  die "session $session still running after 180s"
}

start_session() {
  local session="$1"
  local script="$2"
  tmux_bin kill-session -t "$session" 2>/dev/null || true
  tmux_bin new-session -d -s "$session" -c "$ROOT" -- "$script"
}

combined_logs() {
  local ev="$1"
  cat "$ev/cargo-run.stdout" "$ev/cargo-run.stderr" 2>/dev/null || true
}

require_lines() {
  local ev="$1"
  shift
  local blob missing=() line
  blob="$(combined_logs "$ev")"
  for line in "$@"; do
    if ! grep -q -F -- "$line" <<<"$blob"; then
      missing+=("$line")
    fi
  done
  if ((${#missing[@]})); then
    printf '%s\n' "${missing[@]}"
    return 1
  fi
}

write_proof() {
  local ev="$1"
  local feature="$2"
  local entry="$3"
  local result="$4"
  local exit_code="$5"
  local note="${6:-}"
  {
    echo "feature=$feature"
    echo "entry=$entry"
    echo "head=$(git_head)"
    echo "rustc=$(rustc --version)"
    echo "exit=$exit_code"
    echo "sibling=$(sibling_manifest)"
    if [[ -f "$ROOT/../morpheum-primitives/src/lib.rs" ]]; then
      echo -n "sibling_lib_sha256="
      sha256sum "$ROOT/../morpheum-primitives/src/lib.rs" | awk '{print $1}'
    fi
    if [[ -n "$note" ]]; then
      echo "note=$note"
    fi
    echo "result=$result"
  } >"$ev/proof.txt"
}

exit_of() {
  local ev="$1"
  if [[ -f "$ev/cargo-run.exit" ]]; then
    tr -d '[:space:]' <"$ev/cargo-run.exit"
  else
    echo "missing"
  fi
}

cmd_drive() {
  local feature="${1:-}"
  [[ -n "$feature" ]] || die "usage: verify-mwvm drive <basic-agent|swarm-example|cli-run|gateway-mcp>"
  local id dir ev session
  id="$(run_id)"
  dir="$(run_dir)"
  ev="$(evidence_dir)"
  mkdir -p "$ev"
  if ! cmd_doctor | tee "$ev/doctor.txt"; then
    write_proof "$ev" "$feature" "doctor" "FAIL" "doctor" "doctor failed"
    exit 1
  fi
  session="verify-mwvm-${id}-${feature}"
  case "$feature" in
    basic-agent)
      drive_basic "$dir" "$ev" "$session"
      ;;
    swarm-example)
      drive_swarm "$dir" "$ev" "$session"
      ;;
    cli-run)
      drive_cli "$dir" "$ev" "$session"
      ;;
    gateway-mcp)
      drive_gateway "$dir" "$ev" "$session"
      ;;
    *)
      die "unknown feature $feature"
      ;;
  esac
}

drive_basic() {
  local dir="$1" ev="$2" session="$3"
  local entry="cargo run -p basic-agent"
  printf '%s\n' "$entry" >"$ev/commands.txt"
  write_runner "$dir/drive.sh" "
$entry >\"$ev/cargo-run.stdout\" 2>\"$ev/cargo-run.stderr\"
echo \$? >\"$ev/cargo-run.exit\"
"
  start_session "$session" "$dir/drive.sh"
  wait_session "$session"
  local code missing=""
  code="$(exit_of "$ev")"
  if [[ "$code" == "0" ]] && missing="$(require_lines "$ev" \
    "Engine created" \
    "AgentRuntime instantiated successfully" \
    "hello from basic-agent" \
    "Memory round-trip verified" \
    "Vector search completed" \
    "basic-agent example completed successfully")"; then
    write_proof "$ev" "basic-agent" "$entry" "PASS" "$code"
  else
    write_proof "$ev" "basic-agent" "$entry" "FAIL" "$code" "${missing:-log mismatch}"
    exit 1
  fi
}

drive_swarm() {
  local dir="$1" ev="$2" session="$3"
  local entry="cargo run -p swarm-example"
  printf '%s\n' "$entry" >"$ev/commands.txt"
  write_runner "$dir/drive.sh" "
$entry >\"$ev/cargo-run.stdout\" 2>\"$ev/cargo-run.stderr\"
echo \$? >\"$ev/cargo-run.exit\"
"
  start_session "$session" "$dir/drive.sh"
  wait_session "$session"
  local code missing=""
  code="$(exit_of "$ev")"
  if [[ "$code" == "0" ]] && missing="$(require_lines "$ev" \
    "agent_count=5" \
    "Received broadcast event" \
    "to: None" \
    "payload: [72, 101, 108, 108, 111" \
    "Agent 0 received targeted message" \
    "to: Some(0)" \
    "Swarm example completed successfully")"; then
    write_proof "$ev" "swarm-example" "$entry" "PASS" "$code"
  else
    write_proof "$ev" "swarm-example" "$entry" "FAIL" "$code" "${missing:-log mismatch}"
    exit 1
  fi
}

drive_cli() {
  local dir="$1" ev="$2" session="$3"
  printf '\x00asm\x01\x00\x00\x00' >"$dir/minimal.wasm"
  local entry="cargo run -p mwvm-cli -- run $dir/minimal.wasm"
  printf '%s\n' "$entry" >"$ev/commands.txt"
  write_runner "$dir/drive.sh" "
$entry >\"$ev/cargo-run.stdout\" 2>\"$ev/cargo-run.stderr\"
echo \$? >\"$ev/cargo-run.exit\"
"
  start_session "$session" "$dir/drive.sh"
  wait_session "$session"
  local code missing=""
  code="$(exit_of "$ev")"
  if [[ "$code" == "0" ]] && missing="$(require_lines "$ev" \
    "loading agent from $dir/minimal.wasm" \
    "agent loaded — calling _start" \
    "_start not found or failed")"; then
    write_proof "$ev" "cli-run" "$entry" "PASS" "$code"
  else
    write_proof "$ev" "cli-run" "$entry" "FAIL" "$code" "${missing:-log mismatch}"
    exit 1
  fi
}

drive_gateway() {
  local dir="$1" ev="$2" session="$3"
  printf '\x00asm\x01\x00\x00\x00' >"$dir/minimal.wasm"
  local port
  port="$(python3 - <<'PY'
import socket
s = socket.socket()
s.bind(("127.0.0.1", 0))
print(s.getsockname()[1])
s.close()
PY
)"
  local entry="cargo run -p mwvm-cli -- gateway --wasm-path $dir/minimal.wasm --bind 127.0.0.1:$port"
  printf '%s\n' "$entry" >"$ev/commands.txt"
  echo "port=$port" >>"$ev/commands.txt"
  write_runner "$dir/drive.sh" "
$entry >\"$ev/cargo-run.stdout\" 2>\"$ev/cargo-run.stderr\"
echo \$? >\"$ev/cargo-run.exit\"
"
  start_session "$session" "$dir/drive.sh"
  local i ready=0
  for i in $(seq 1 90); do
    if grep -q -F "MWVM Gateway listening" "$ev/cargo-run.stdout" 2>/dev/null; then
      ready=1
      break
    fi
    if ! tmux_bin has-session -t "$session" 2>/dev/null; then
      break
    fi
    sleep 1
  done
  local curl_code=0
  if [[ "$ready" -eq 1 ]]; then
    curl -sS -D "$ev/http.headers" -o "$ev/http.body" -w "%{http_code}" \
      -H 'content-type: application/json' \
      --data '{"method":"tools/list","params":{}}' \
      "http://127.0.0.1:$port/mcp" >"$ev/http.status" || curl_code=$?
  fi
  tmux_bin kill-session -t "$session" 2>/dev/null || true
  local http
  http="$(tr -d '[:space:]' <"$ev/http.status" 2>/dev/null || echo missing)"
  local missing=""
  if [[ "$ready" -ne 1 ]]; then
    missing="gateway did not log MWVM Gateway listening"
  elif [[ "$curl_code" -ne 0 ]]; then
    missing="curl exit $curl_code"
  elif [[ "$http" != "200" ]]; then
    missing="http status $http"
  elif ! grep -q -F '"name":"infer"' "$ev/http.body" || ! grep -q -F '"name":"search_memory"' "$ev/http.body"; then
    missing="tools/list body missing infer or search_memory"
  fi
  if [[ -z "$missing" ]]; then
    write_proof "$ev" "gateway-mcp" "$entry" "PASS" "0"
  else
    write_proof "$ev" "gateway-mcp" "$entry" "FAIL" "$http" "$missing"
    exit 1
  fi
}

cmd_evidence() {
  local ev proof
  ev="$(evidence_dir)"
  proof="$ev/proof.txt"
  [[ -f "$proof" ]] || die "no proof at $proof"
  cat "$proof"
  grep -q '^result=PASS$' "$proof"
}

cmd_cleanup() {
  local id ev
  id="$(run_id)"
  ev="$(evidence_dir)"
  local name
  if tmux_bin list-sessions -F '#{session_name}' >/tmp/verify-mwvm-sessions 2>/dev/null; then
    while read -r name; do
      case "$name" in
        "verify-mwvm-${id}-"*) tmux_bin kill-session -t "$name" 2>/dev/null || true ;;
      esac
    done </tmp/verify-mwvm-sessions
  fi
  rm -f /tmp/verify-mwvm-sessions
  rm -rf "$STATE/runs/$id"
  if [[ -f "$LOCK/run_id" ]] && [[ "$(cat "$LOCK/run_id")" == "$id" ]]; then
    rm -rf "$LOCK"
  fi
  if [[ -f "$CURRENT" ]] && [[ "$(cat "$CURRENT")" == "$id" ]]; then
    rm -f "$CURRENT"
  fi
  [[ -d "$ev" ]] || die "cleanup removed evidence $ev"
  printf 'evidence=%s\n' "$ev"
}

main() {
  local cmd="${1:-}"
  shift || true
  case "$cmd" in
    launch) cmd_launch "$@" ;;
    doctor) cmd_doctor "$@" ;;
    drive) cmd_drive "$@" ;;
    evidence) cmd_evidence "$@" ;;
    cleanup) cmd_cleanup "$@" ;;
    *)
      die "usage: verify-mwvm <launch|doctor|drive|evidence|cleanup>"
      ;;
  esac
}

main "$@"
